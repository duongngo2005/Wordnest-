DATABASE_URL="mysql://wordnest_app:wordnest@localhost:3306/wordnest"
GEMINI_API_KEY="key1,key2" # Supports multiple comma-separated keys for auto-rotation
GEMINI_API_KEYS_EXTRA="" # Optional additional comma-separated keys, kept separate from the primary pool
GEMINI_API_KEYS_ADDITIONAL="" # Additive local/deployment key pool; it never replaces the pools above
GEMINI_REQUEST_TIMEOUT_MS="45000" # 429s rotate immediately; slow requests may use up to 45 seconds
OPENROUTER_API_KEY="" # Gemini fallback; only the built-in free-model allowlist is used
UNSPLASH_ACCESS_KEY=""
# Server-only Azure Speech credentials. Do not use NEXT_PUBLIC_ names.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# Optional persistent cache location. Defaults to .wordnest-cache/tts on this self-hosted app.
TTS_CACHE_DIR=""
