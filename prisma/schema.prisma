datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FlashcardStatus {
  NEW
  LEARNING
  KNOWN
}

model Deck {
  id           String        @id @default(cuid())
  name         String
  description  String?       @db.Text
  folderId     String?
  folder       Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cards        Flashcard[]
  stories      Story[]
  quizAttempts QuizAttempt[]
  quizSessions QuizSession[]

  @@index([folderId])
  @@index([folderId, position])
  @@map("decks")
}

model Folder {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?  @db.Text
  icon           String   @default("book")
  color          String   @default("orange")
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  decks          Deck[]

  @@index([position])
  @@map("folders")
}

model Flashcard {
  id               String          @id @default(cuid())
  deckId           String
  deck             Deck            @relation(fields: [deckId], references: [id], onDelete: Cascade)
  term             String
  normalizedTerm   String
  meaningVi        String          @db.Text
  definitionEn     String?         @db.Text
  ipa              String?
  partOfSpeech     String?
  cefr             String?
  exampleEn        String?         @db.Text
  exampleVi        String?         @db.Text
  imageUrl         String?         @db.Text
  imageSource      String?
  imageSearchQuery String?
  imagePageUrl     String?         @db.Text
  imageAuthor      String?
  imageLicense     String?
  status           FlashcardStatus @default(NEW)
  due              DateTime        @default(now())
  lastReviewAt     DateTime?
  reps             Int             @default(0)
  lapses           Int             @default(0)
  stability        Float           @default(0)
  difficulty       Float           @default(0)
  elapsedDays      Int             @default(0)
  scheduledDays    Int             @default(0)
  learningSteps    Int             @default(0)
  state            Int             @default(0) // 0: New, 1: Learning, 2: Review, 3: Relearning
  schedulerVersion Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  reviewLogs       ReviewLog[]
  practiceAttempts PracticeAttempt[]

  @@unique([deckId, normalizedTerm])
  @@index([deckId])
  @@index([due])
  @@index([deckId, due])
  @@map("flashcards")
}

model ReviewLog {
  id              String    @id @default(cuid())
  cardId          String
  card            Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating          Int       // 1: Again, 2: Hard, 3: Good, 4: Easy
  state           Int       // FSRS State prior to review
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  lastElapsedDays Int
  scheduledDays   Int
  reviewEventId   String?   @unique @db.VarChar(191)
  review          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([cardId])
  @@index([review])
  @@map("review_logs")
}

model Story {
  id          String   @id @default(cuid())
  deckId      String
  deck        Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  title       String
  content     String   @db.Text
  cefr        String
  length      String
  topic       String
  targetWords Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@map("stories")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  accuracy  Float
  createdAt DateTime @default(now())

  @@index([deckId])
  @@map("quiz_attempts")
}

model QuizSession {
  id        String   @id @default(cuid())
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  questions Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([deckId])
  @@index([expiresAt])
  @@map("quiz_sessions")
}

// Per-question, server-scored practice evidence. QuizSession is deliberately not
// referenced: it is deleted once submitted, while sessionId remains useful for
// grouping the immutable historical attempts that it produced.
model PracticeAttempt {
  id             String    @id @default(cuid())
  flashcardId    String
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  sessionId      String    @db.VarChar(191)
  questionId     String?   @db.VarChar(191)
  prompt         String?   @db.Text
  attemptNumber  Int       @default(1)
  mode           String    @db.VarChar(32)
  questionType   String    @db.VarChar(64)
  correct        Boolean
  answer         String    @db.Text
  expectedAnswer String    @db.Text
  responseMs     Int?
  createdAt      DateTime  @default(now())

  @@index([flashcardId, createdAt])
  @@index([sessionId])
  @@index([sessionId, questionId])
  @@map("practice_attempts")
}
