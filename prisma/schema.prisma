datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FlashcardStatus {
  NEW
  LEARNING
  KNOWN
}

model Deck {
  id                    String                     @id @default(cuid())
  name                  String
  description           String?
  folderId              String?
  folder                Folder?                    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  position              Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  cards                 Flashcard[]                @relation("LegacyFlashcardDeck")
  vocabularyMemberships DeckVocabularyMembership[]
  stories               Story[]
  lessons               Lesson[]
  quizAttempts          QuizAttempt[]
  quizSessions          QuizSession[]

  @@index([folderId])
  @@index([folderId, position])
  @@map("decks")
}

model Folder {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?
  icon           String   @default("book")
  color          String   @default("orange")
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  decks          Deck[]

  @@index([position])
  @@map("folders")
}

model Flashcard {
  id               String          @id @default(cuid())
  // `deckId` preserves the former one-to-many source during the staged
  // migration. New application code must use `deckMemberships`; this nullable
  // field exists only for backwards-compatible storage and is never the source
  // of truth for deck membership.
  deckId           String?
  deck             Deck?           @relation("LegacyFlashcardDeck", fields: [deckId], references: [id], onDelete: SetNull)
  term             String
  normalizedTerm   String
  meaningVi        String
  definitionEn     String?
  ipa              String?
  partOfSpeech     String?
  cefr             String?
  exampleEn        String?
  exampleVi        String?
  imageUrl         String?
  imageSource      String?
  imageSearchQuery String?
  imagePageUrl     String?
  imageAuthor      String?
  imageLicense     String?
  status           FlashcardStatus @default(NEW)
  due              DateTime        @default(now())
  lastReviewAt     DateTime?
  reps             Int             @default(0)
  lapses           Int             @default(0)
  stability        Float           @default(0)
  difficulty       Float           @default(0)
  elapsedDays      Int             @default(0)
  scheduledDays    Int             @default(0)
  learningSteps    Int             @default(0)
  state            Int             @default(0) // 0: New, 1: Learning, 2: Review, 3: Relearning
  schedulerVersion Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  reviewLogs       ReviewLog[]
  practiceAttempts PracticeAttempt[]
  deckMemberships  DeckVocabularyMembership[]
  canonicalVocabularyIdentity VocabularyIdentity? @relation("VocabularyIdentityCanonicalFlashcard")

  @@unique([deckId, normalizedTerm])
  @@index([deckId])
  @@index([due])
  @@index([deckId, due])
  @@map("flashcards")
}

// A Deck membership is organizational source metadata only. It never has its
// own Flashcard, FSRS state, ReviewLog, or PracticeAttempt; each points to the
// one canonical Flashcard row.
model DeckVocabularyMembership {
  id          String    @id @default(cuid())
  deckId      String
  flashcardId String
  deck        Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([deckId, flashcardId])
  @@index([flashcardId])
  @@map("deck_vocabulary_memberships")
}

// A global vocabulary identity is deliberately separate from the deck-owned
// Flashcard row. Every newly written Flashcard is protected by SQLite triggers
// that reserve exactly one normalized identity. Historical duplicate groups
// are retained without auto-merging their Flashcards or learning history and
// are marked for explicit human resolution.
model VocabularyIdentity {
  id                      String     @id @default(cuid())
  normalizedTerm          String     @unique
  canonicalFlashcardId    String?    @unique
  canonicalFlashcard      Flashcard? @relation("VocabularyIdentityCanonicalFlashcard", fields: [canonicalFlashcardId], references: [id], onDelete: SetNull)
  hasHistoricalDuplicates Boolean    @default(false)
  historicalDuplicateCount Int       @default(0)
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@map("vocabulary_identities")
}

model ReviewLog {
  id              String    @id @default(cuid())
  cardId          String
  card            Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  rating          Int       // 1: Again, 2: Hard, 3: Good, 4: Easy
  state           Int       // FSRS State prior to review
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Int
  lastElapsedDays Int
  scheduledDays   Int
  reviewEventId   String?   @unique
  review          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([cardId])
  @@index([review])
  @@map("review_logs")
}

model Story {
  id          String   @id @default(cuid())
  deckId      String?
  deck        Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  title       String
  content     String
  cefr        String
  length      String
  topic       String
  targetWords Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@map("stories")
}

model Lesson {
  id          String   @id @default(cuid())
  deckId      String?
  deck        Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  title       String
  content     String
  cefr        String
  targetWords Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deckId])
  @@map("lessons")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  deckId    String?
  deck      Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  score     Int
  total     Int
  accuracy  Float
  createdAt DateTime @default(now())

  @@index([deckId])
  @@map("quiz_attempts")
}

model QuizSession {
  id        String   @id @default(cuid())
  deckId    String?
  deck      Deck?    @relation(fields: [deckId], references: [id], onDelete: SetNull)
  questions Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([deckId])
  @@index([expiresAt])
  @@map("quiz_sessions")
}

// Per-question, server-scored practice evidence. QuizSession is deliberately not
// referenced: it is deleted once submitted, while sessionId remains useful for
// grouping the immutable historical attempts that it produced.
model PracticeAttempt {
  id             String    @id @default(cuid())
  flashcardId    String
  flashcard      Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  sessionId      String
  questionId     String?
  prompt         String?
  attemptNumber  Int       @default(1)
  mode           String
  questionType   String
  correct        Boolean
  answer         String
  expectedAnswer String
  responseMs     Int?
  createdAt      DateTime  @default(now())

  @@index([flashcardId, createdAt])
  @@index([sessionId])
  @@index([sessionId, questionId])
  @@map("practice_attempts")
}

// A compact, global activity ledger. It records foreground, recently-active
// WordNest time per study-day without attaching time to a Flashcard, Deck, or
// FSRS history.
model DailyOnlineActivity {
  date          String   @id
  activeSeconds Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("daily_online_activity")
}

model AiJob {
  id           String    @id @default(cuid())
  type         String    @default("story_generation")
  status       String    @default("queued") // queued | running | completed | failed | cancelled | interrupted
  stage        String?   @default("queued") // queued | generating_story | validating_vocabulary | repairing_story | generating_translations | saving | completed
  progress     Int       @default(0)
  input        Json
  result       Json?
  resultId     String?
  resultUrl    String?
  errorCode    String?
  errorMessage String?
  cancelRequestedAt DateTime?
  idempotencyKey String? @unique
  // A worker claim is fenced by this token. A stale worker cannot persist over
  // a later recovery claim because every worker-side mutation checks it.
  workerId         String?
  leaseToken       String?
  leaseExpiresAt   DateTime?
  heartbeatAt      DateTime?
  availableAt      DateTime?
  attemptCount     Int       @default(0)
  totalItems       Int       @default(0)
  processedItems   Int       @default(0)
  acceptedItems    Int       @default(0)
  failedItems      Int       @default(0)
  currentItemId    String?
  currentTerm      String?
  items            AiJobItem[]
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([type, status])
  @@index([status, createdAt, id])
  @@index([status, availableAt, createdAt, id])
  @@index([leaseExpiresAt])
  @@map("ai_jobs")
}

// Durable, independently reviewable checkpoints for a flashcard batch. These
// are staging records only: an accepted draft has no Flashcard row until the
// user explicitly confirms it through the server-side confirmation endpoint.
model AiJobItem {
  id               String   @id @default(cuid())
  jobId            String
  job              AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence         Int
  requestedTerm    String
  status           String   @default("pending")
  stage            String   @default("pending")
  attemptCount     Int      @default(0)
  retryAfter       DateTime?
  failureCategory  String?
  failureReason    String?
  draft            Json?
  savedFlashcardId String?  @unique
  createdAt        DateTime @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  updatedAt        DateTime @updatedAt

  @@unique([jobId, sequence])
  @@index([jobId, status, sequence])
  @@index([status, retryAfter])
  @@map("ai_job_items")
}
